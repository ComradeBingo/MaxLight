<Window x:Class="MaxLight.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки"
        Height="660"
        Width="900"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <SolidColorBrush x:Key="HeaderBackground" Color="#424B79"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#424B79"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceLightBrush" Color="#F5F6FA"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#2C3E50"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#636E72"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#E74C3C"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#72bf6a"/>
        <SolidColorBrush x:Key="PurpleBrush" Color="#56569D"/>
        <SolidColorBrush x:Key="GrayBrush" Color="#95A5A6"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0"/>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20,18"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="1" Opacity="0.06" BlurRadius="10"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource SurfaceLightBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource SurfaceLightBrush}" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="4" Opacity="0.15" BlurRadius="20"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Border Grid.Row="0" Background="{StaticResource HeaderBackground}" CornerRadius="16,16,0,0" Height="56"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="20,0">
                    <TextBlock Text="Настройки MaxLight" FontSize="16" FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Контент: 2 колонки -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ЛЕВАЯ КОЛОНКА -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ОБЩИЕ" Style="{StaticResource SectionTitleStyle}"/>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <CheckBox x:Name="chkAutoStart" Content="Запускать при входе в Windows"
                                          Style="{StaticResource ModernCheckBox}"
                                          Checked="ChkAutoStart_CheckedChanged" Unchecked="ChkAutoStart_CheckedChanged"/>
                                <Separator Opacity="0.2" Margin="0,2"/>
                                <CheckBox x:Name="chkNotificationsOnTop" Content="Уведомления поверх всех окон"
                                          Style="{StaticResource ModernCheckBox}"
                                          Checked="ChkNotificationsOnTop_CheckedChanged" Unchecked="ChkNotificationsOnTop_CheckedChanged"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="АККАУНТ" Style="{StaticResource SectionTitleStyle}"/>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Button x:Name="btnPinSettings" 
                                        Content="🔐 PIN-код" 
                                        Background="{StaticResource PrimaryBrush}"
                                        Style="{StaticResource ModernButton}" 
                                        HorizontalAlignment="Stretch"
                                        Click="BtnPinSettings_Click"/>
                                <Button Content="Выйти с устройства (удалить токен и пин-код)" 
                                        Background="{StaticResource DangerBrush}"
                                        Style="{StaticResource ModernButton}" 
                                        HorizontalAlignment="Stretch" 
                                        Margin="0,8,0,0"
                                        Click="BtnLogout_Click"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="ОБНОВЛЕНИЯ" Style="{StaticResource SectionTitleStyle}"/>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Button x:Name="btnCheckUpdates" 
                                        Content="ПРОВЕРИТЬ ОБНОВЛЕНИЯ" 
                                        Background="{StaticResource PurpleBrush}"
                                        Style="{StaticResource ModernButton}" 
                                        HorizontalAlignment="Stretch"
                                        Click="BtnCheckUpdates_Click"/>
                                <TextBlock x:Name="lblUpdateStatus" FontSize="12" Margin="6,6,0,0" Visibility="Collapsed"/>
                                <Button Content="О ПРОГРАММЕ" 
                                        Background="{StaticResource SuccessBrush}"
                                        Style="{StaticResource ModernButton}" 
                                        HorizontalAlignment="Stretch" 
                                        Margin="0,12,0,0"
                                        Click="BtnAbout_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ПРАВАЯ КОЛОНКА -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ПРОКСИ" Style="{StaticResource SectionTitleStyle}"/>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <CheckBox x:Name="chkProxyEnabled" Content="Использовать прокси"
                                          Style="{StaticResource ModernCheckBox}" Margin="0,0,0,12"
                                          Checked="ChkProxyEnabled_CheckedChanged" Unchecked="ChkProxyEnabled_CheckedChanged"/>

                                <!-- Сервер -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Сервер" Style="{StaticResource LabelStyle}" Width="60"/>
                                    <TextBox Grid.Column="1" x:Name="txtProxyServer" Style="{StaticResource ModernTextBox}"
                                             IsEnabled="False" TextChanged="ProxySettings_Changed"/>
                                </Grid>

                                <!-- Порт -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Порт" Style="{StaticResource LabelStyle}" Width="60"/>
                                    <TextBox Grid.Column="1" x:Name="numProxyPort" Style="{StaticResource ModernTextBox}"
                                             Text="8080" IsEnabled="False" Width="120" HorizontalAlignment="Left"
                                             PreviewTextInput="NumProxyPort_PreviewTextInput"
                                             TextChanged="ProxySettings_Changed"/>
                                </Grid>

                                <!-- Кнопка Применить по центру -->
                                <Button x:Name="btnApplyProxy" Content="Применить"
                                        Background="{StaticResource SuccessBrush}" Style="{StaticResource ModernButton}"
                                        HorizontalAlignment="Center" IsEnabled="False" Width="160"
                                        Click="BtnApplyProxy_Click"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="ЗАГРУЗКИ" Style="{StaticResource SectionTitleStyle}"/>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtDownloadPath" Style="{StaticResource ModernTextBox}"
                                             IsReadOnly="True" VerticalContentAlignment="Center" FontSize="13"/>
                                    <Button Grid.Column="1" Content="Обзор" Margin="6,0,0,0"
                                            Background="{StaticResource PrimaryBrush}" Style="{StaticResource ModernButton}"
                                            Padding="16,8" FontSize="14"
                                            Click="BtnBrowseDownloadPath_Click"/>
                                </Grid>
                                <CheckBox x:Name="chkAskEveryTime" Content="Спрашивать каждый раз при скачивании"
                                          Style="{StaticResource ModernCheckBox}"
                                          Checked="ChkAskEveryTime_CheckedChanged" Unchecked="ChkAskEveryTime_CheckedChanged"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Нижняя панель -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceLightBrush}" CornerRadius="0,0,12,12"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Height="60">
                <Button Content="ЗАКРЫТЬ" Background="{StaticResource HeaderBackground}"
                        Foreground="White" FontSize="14" FontWeight="Bold"
                        Width="125" BorderThickness="0" Cursor="Hand"
                        Click="BtnClose_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="30,10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>