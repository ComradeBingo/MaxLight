<Window x:Class="MaxLight.PinSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Установка PIN-кода"
        Height="400" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

	<Border Background="#424B79" CornerRadius="12">
		<Border.Effect>
			<DropShadowEffect ShadowDepth="4" Opacity="0.3" BlurRadius="20"/>
		</Border.Effect>

		<Grid Margin="30">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<!-- Заголовок -->
			<TextBlock Grid.Row="0"
                       Text="Установка PIN-кода"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>

			<!-- Описание -->
			<TextBlock Grid.Row="1"
                       Text="PIN-код защитит ваш аккаунт при запуске приложения"
                       FontSize="13"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,20"/>

			<!-- Поле ввода PIN -->
			<StackPanel Grid.Row="2" Margin="0,0,0,15">
				<TextBlock Text="Введите PIN-код (4-6 цифр)"
                           Foreground="White"
                           FontSize="14"
                           Margin="0,0,0,5"/>
				<PasswordBox x:Name="txtPin"
                             MaxLength="6"
                             Height="35"
                             FontSize="18"
                             Background="White"
                             Foreground="#3C3C3C"
                             BorderBrush="#555555"
                             BorderThickness="1"
                             PasswordChanged="TxtPin_PasswordChanged"/>
				<TextBlock x:Name="lblPinError"
                           Text=""
                           Foreground="#E74C3C"
                           FontSize="11"
                           Visibility="Collapsed"
                           Margin="0,5,0,0"/>
			</StackPanel>

			<!-- Подтверждение PIN -->
			<StackPanel Grid.Row="3" Margin="0,0,0,20">
				<TextBlock Text="Подтвердите PIN-код"
                           Foreground="White"
                           FontSize="14"
                           Margin="0,0,0,5"/>
				<PasswordBox x:Name="txtPinConfirm"
                             MaxLength="6"
                             Height="35"
                             FontSize="18"
                             Background="White"
                             Foreground="#3C3C3C"
                             BorderBrush="#555555"
                             BorderThickness="1"
                             PasswordChanged="TxtPin_PasswordChanged"/>
				<TextBlock x:Name="lblConfirmError"
                           Text=""
                           Foreground="#E74C3C"
                           FontSize="11"
                           Visibility="Collapsed"
                           Margin="0,5,0,0"/>
			</StackPanel>

			<!-- Кнопки -->
			<StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
				<Button x:Name="btnSave"
                        Content="Установить PIN"
                        Width="160" Height="40"
                        Background="#27AE60"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"
                        IsEnabled="False"
                        Click="BtnSave_Click"/>
				<Button x:Name="btnSkip"
                        Content="Пропустить"
                        Width="120" Height="40"
                        Background="#555555"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="10,0,0,0"
                        Click="BtnSkip_Click"/>
			</StackPanel>

			<!-- Подпись снизу -->
			<TextBlock Grid.Row="5"
                       Text="Вы можете настроить PIN позже в настройках"
                       FontSize="14"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,15,0,0"/>
		</Grid>
	</Border>
</Window>