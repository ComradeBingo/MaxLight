<Window x:Class="MaxLight.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Уведомление"
        Width="380"
        Height="Auto"
        MinHeight="120"
        MaxHeight="250"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Loaded="Window_Loaded"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        ShowActivated="False"
        Focusable="False">

	<Border Background="#424B79"
            CornerRadius="12"
            Padding="12">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<!-- Верхняя часть -->
			<Grid Grid.Row="0" Margin="0,0,0,8">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<!-- Аватар -->
				<Grid Grid.Column="0" Margin="0,0,12,0">
					<Border CornerRadius="32"
                            Width="48"
                            Height="48"
                            ClipToBounds="True"
                            Background="#3C3C41">
						<Image x:Name="imgAvatar"
                               Stretch="UniformToFill"
                               Visibility="Collapsed"
                               Cursor="Hand"
                               MouseLeftButtonDown="Avatar_MouseLeftButtonDown"/>
					</Border>

					<Border x:Name="borderInitials"
                            CornerRadius="32"
                            Background="#3C3C41"
                            Width="48"
                            Height="48"
                            Cursor="Hand"
                            MouseLeftButtonDown="Avatar_MouseLeftButtonDown">
						<TextBlock x:Name="txtInitials"
                                   Text="?"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
					</Border>
				</Grid>

				<!-- Заголовок -->
				<TextBlock Grid.Column="1"
                           x:Name="txtTitle"
                           Text="Заголовок"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           MaxHeight="40"
                           Cursor="Hand"
                           MouseLeftButtonDown="Title_MouseLeftButtonDown"/>

				<!-- Кнопка закрытия -->
				<Button Grid.Column="2"
                        x:Name="btnClose"
                        Content="✕"
                        Width="28"
                        Height="28"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="#B4B4B4"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Right"
                        Click="BtnClose_Click"/>
			</Grid>

			<!-- Текст сообщения -->
			<TextBlock Grid.Row="1"
                       x:Name="txtMessage"
                       Text="Сообщение"
                       FontSize="14"
                       Foreground="#DCDCDC"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       MaxHeight="140"
                       Cursor="Hand"
                       MouseLeftButtonDown="Message_MouseLeftButtonDown"/>
		</Grid>
	</Border>
</Window>