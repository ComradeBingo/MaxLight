<Window x:Class="MaxLight.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обновление" 
        Width="550" 
        Height="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent">

    <Border Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Border Grid.Row="0" Background="#424B79" CornerRadius="8,8,0,0" Height="48">
                <Grid Margin="15,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Доступно обновление" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="White"/>
                        <TextBlock x:Name="txtVersion" 
                                   Text="Версия 1.0.0" 
                                   FontSize="11" 
                                   Foreground="#BDC3C7" 
                                   VerticalAlignment="Center" 
                                   Margin="20,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Контент -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="📝 Что нового:" 
                           FontSize="12" 
                           FontWeight="Bold" 
                           Foreground="#34495E" 
                           Margin="0,0,0,10"/>

                <Border Grid.Row="1" 
                        Background="#F8F9FA" 
                        CornerRadius="4"
                        BorderBrush="#E0E0E0" 
                        BorderThickness="1">
                    <TextBox x:Name="txtReleaseNotes"
                             Text="Описание изменений..."
                             FontSize="14"
                             Foreground="#34495E"
                             Background="Transparent"
                             BorderThickness="0"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             IsReadOnly="True"
                             Padding="10"/>
                </Border>
            </Grid>

            <!-- Кнопки -->
            <StackPanel Grid.Row="2" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        Margin="0,0,0,20">
                <Button x:Name="btnUpdate"
                        Content="✅ Обновить"
                        Width="150"
                        Height="38"
                        FontSize="11"
                        FontWeight="Bold"
                        Background="#2ECC71"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,15,0"
                        Click="BtnUpdate_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" 
                                                VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="btnSkip"
                        Content="Пропустить"
                        Width="120"
                        Height="38"
                        FontSize="11"
                        Background="#95A5A6"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnSkip_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" 
                                                VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>