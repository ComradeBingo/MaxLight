<Window x:Class="MaxLight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MaxLight" 
        Width="1050" 
        Height="800"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Background="#424B79"
        
        MouseMove="MainWindow_MouseMove"
        MouseLeftButtonDown="MainWindow_MouseLeftButtonDown">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="AppTaskbarInfo"/>
    </Window.TaskbarItemInfo>

    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundColorBrush" Color="#424B79"/>
        <SolidColorBrush x:Key="HoverColorBrush" Color="#3C3C3C"/>
        <SolidColorBrush x:Key="TextColorBrush" Color="#C8C8C8"/>
        <SolidColorBrush x:Key="CloseHoverColorBrush" Color="#E81123"/>
        <SolidColorBrush x:Key="ClosePressedColorBrush" Color="#B40A14"/>
        <SolidColorBrush x:Key="NotificationBgBrush" Color="#56569D"/>
        <SolidColorBrush x:Key="NotificationTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TitleTextBrush" Color="#F6F4F9"/>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextColorBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverColorBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource CloseHoverColorBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource ClosePressedColorBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#FF2D3250" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TitleBar -->
            <Grid Grid.Row="0" 
                  Background="{StaticResource BackgroundColorBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock x:Name="lblTitle"
                               Text="Max Light   v1.0.0"
                               FontFamily="Segoe UI"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{StaticResource TitleTextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Border x:Name="updateNotification"
        Grid.Column="0"
        Background="{StaticResource NotificationBgBrush}"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Width="240"
        Height="32"
        Visibility="Collapsed"
        Cursor="Hand"
        MouseLeftButtonDown="UpdateNotification_Click">
                    <StackPanel Orientation="Horizontal" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center">
                        <TextBlock Text="&#xE896;" 
                   FontFamily="Segoe MDL2 Assets" 
                   FontSize="14" 
                   FontWeight="Bold"
                   Foreground="{StaticResource NotificationTextBrush}"
                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblUpdateNotification"
                   Text=" ОБНОВИТЬ ДО 1.0.0"
                   FontFamily="Segoe UI" 
                   FontSize="12" 
                   FontWeight="Bold"
                   Foreground="{StaticResource NotificationTextBrush}"
                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button x:Name="btnSettings"
        ToolTip="Настройки"
        Height="36"
        Padding="10,0"
        Cursor="Hand"
        Click="Settings_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" 
                    Background="Transparent" 
                    Height="36" 
                    Padding="10,0"
                    CornerRadius="4">
                                    <TextBlock VerticalAlignment="Center">
                    <Run Text="&#xE713;" 
                         FontFamily="Segoe MDL2 Assets" 
                         FontSize="14" 
                         Foreground="#C8C8C8"/>
                    <Run Text="  Настройки" 
                         FontFamily="Segoe UI" 
                         FontSize="14" 
                         Foreground="#C8C8C8"/>
                                    </TextBlock>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#3C3C3C"/>
                                        <Setter TargetName="border" Property="TextElement.Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="btnMinimize"
                            Content="&#xE921;"
                            Style="{StaticResource TitleBarButton}"
                            ToolTip="Свернуть"
                            FontSize="14"
                            Click="Minimize_Click"/>
                    <Button x:Name="btnMaximize"
                            Content="&#xE922;"
                            FontSize="14"
                            Style="{StaticResource TitleBarButton}"
                            ToolTip="Развернуть"
                            Click="Maximize_Click"/>
                    <Button x:Name="btnClose"
                            Content="&#xE711;"
                            FontSize="14"
                            Style="{StaticResource CloseButton}"
                            ToolTip="Закрыть"
                            Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- Контент -->
            <Grid Grid.Row="1">
                <wpf:WebView2 x:Name="webView" Visibility="Visible"/>

                <Border x:Name="errorPanel" 
                        Background="#F8F9FA" 
                        Visibility="Collapsed">
                    <Border Background="White" 
                            BorderBrush="#DEE2E6" 
                            BorderThickness="1"
                            CornerRadius="8"
                            Width="400" 
                            Height="220"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="⚠️" FontSize="48" Foreground="#DC3545"
                                       HorizontalAlignment="Center" Margin="0,20,0,10"/>
                            <TextBlock Text="Не могу подключиться" FontSize="16" FontWeight="Bold"
                                       Foreground="#343A40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Проверьте соединение с интернетом" FontSize="11"
                                       Foreground="#6C757D" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                            <Button x:Name="btnRetry" Content="Повторить"
                                    Width="120" Height="35"
                                    Background="#007BFF" Foreground="White"
                                    FontSize="12" FontWeight="Bold"
                                    BorderThickness="0" Cursor="Hand"
                                    HorizontalAlignment="Center"
                                    Click="BtnRetry_Click"/>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>